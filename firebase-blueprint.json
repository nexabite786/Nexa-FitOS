      "type": "object",
      "properties": {
        "programId": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string" },
        "weekNumber": { "type": "integer" },
        "dayOfWeek": { "type": "string" },
        "order": { "type": "integer" },
