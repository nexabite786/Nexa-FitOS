{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "currentTenantId": { "type": "string" },
        "onboardingComplete": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "firstName", "lastName"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Gym / Fitness Business Tenant",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string" },
        "subdomain": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "Exercise definition in the library (system or custom)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "targetMuscleGroup": { "type": "string", "maxLength": 60 },
        "secondaryMuscles": { "type": "array", "items": { "type": "string" } },
        "equipment": { "type": "string", "maxLength": 60 },
